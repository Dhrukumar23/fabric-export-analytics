		annotation SummarizationSetBy = User

	partition 'Data Quality' = m
		mode: import
		source =
				let
				    Source = fnReadGold("fact_data_quality"),
				    Typed = Table.TransformColumnTypes(Source, {{"contract", type text}, {"file", type text}, {"check", type text}, {"rows_checked", Int64.Type}, {"rows_failed", Int64.Type}, {"severity", type text}, {"action", type text}, {"check_date", type date}, {"run_id", type text}, {"run_timestamp", type datetime}, {"date_key", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
