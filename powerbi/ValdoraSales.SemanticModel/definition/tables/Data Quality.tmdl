/// One row per data-contract check per load. Appended on every pipeline run.
table 'Data Quality'
	lineageTag: bae25aa5-8603-5ab3-898b-dc251be1bf38

	measure 'Rows Quarantined' = CALCULATE ( SUM ( 'Data Quality'[Rows Failed] ), 'Data Quality'[Action] = "quarantined" ) + 0
		formatString: #,0
		lineageTag: c08427c5-7c26-5a74-bf33-722ae1f8c10c

	measure 'Values Auto-Fixed' = CALCULATE ( SUM ( 'Data Quality'[Rows Failed] ), 'Data Quality'[Action] = "auto-fixed" ) + 0
		formatString: #,0
		lineageTag: be20acb4-135d-55e5-906c-3a1577056e3a

	measure 'Duplicates Removed' = CALCULATE ( SUM ( 'Data Quality'[Rows Failed] ), 'Data Quality'[Action] = "deduplicated" ) + 0
		formatString: #,0
		lineageTag: 061d1feb-e06a-500b-99fc-faeb6689949b

	measure 'ERP Rows Received' = CALCULATE ( SUM ( 'Data Quality'[Rows Checked] ), 'Data Quality'[Contract] = "erp_order_lines", 'Data Quality'[Check] = "order_id: required" )
		formatString: #,0
		lineageTag: df934d2f-f8b9-5b4a-9df5-4c0a9d51d073

	measure 'Quarantine Rate' = DIVIDE ( CALCULATE ( [Rows Quarantined], 'Data Quality'[Contract] = "erp_order_lines" ), [ERP Rows Received] )
		formatString: 0.00%
		lineageTag: 40716317-9d4d-520a-a5e9-8d249d8dd1fa

	measure 'Contract Checks Run' = COUNTROWS ( 'Data Quality' )
		formatString: #,0
		lineageTag: d888d0d6-f2f6-5dee-ba99-babbee6f7f97

	measure 'Last Pipeline Run' = CALCULATE ( MAX ( 'Data Quality'[Run Timestamp] ), REMOVEFILTERS () )
		formatString: dd.mm.yyyy hh:nn
		lineageTag: 08714f84-b841-5f0f-8cd9-ac5456ab173f

	/// Days between the last loaded business date and today. Alert if > 3.
	measure 'Data Age (days)' = DATEDIFF ( [Last Actual Date], TODAY (), DAY )
		formatString: 0
		lineageTag: 54ff0f27-7b31-5859-b9b6-f6a685ca248c

	column Contract
		dataType: string
		lineageTag: 2c1d17f2-25f5-589e-b1a8-3b08de45366b
		summarizeBy: none
		sourceColumn: contract

		annotation SummarizationSetBy = User

	column File
		dataType: string
		lineageTag: 321a649c-103a-5693-bc60-4ac0c1314ee9
		summarizeBy: none
		sourceColumn: file

