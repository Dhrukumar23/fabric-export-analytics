		lineageTag: 5ba32b1d-2265-5a9b-b96f-594c80a0d2a3
		summarizeBy: none
		sourceColumn: check

		annotation SummarizationSetBy = User

	column 'Rows Checked'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: b513cd90-6199-553b-953b-f92b05a4abb8
		summarizeBy: none
		sourceColumn: rows_checked

		annotation SummarizationSetBy = User

	column 'Rows Failed'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 1ba7f938-3f08-53f5-958a-f3fe4cf337d4
		summarizeBy: none
		sourceColumn: rows_failed

		annotation SummarizationSetBy = User

	column Severity
