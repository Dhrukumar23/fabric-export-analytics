		lineageTag: 2487784e-6f61-519a-b9a8-2e5c3bb67f21
		summarizeBy: none
		sourceColumn: run_timestamp

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = DateTime

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
