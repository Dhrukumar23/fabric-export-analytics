/// Order lines and returns at line grain. All measures live here, grouped in display folders.
table Sales
	lineageTag: 3464c205-4932-5545-8d20-97453ebb03b2

	/// Invoiced revenue after discounts and returns, converted to EUR at the ECB rate of the order date.
	measure 'Net Revenue' = SUM ( Sales[Net EUR] )
		formatString: "€"#,0
		displayFolder: 1 Revenue
		lineageTag: 474d4aef-21ba-5bcd-8a5f-f9707b643153

	measure 'Gross Revenue' = SUM ( Sales[Gross EUR] )
		formatString: "€"#,0
		displayFolder: 1 Revenue
		lineageTag: 1af09b33-35b8-5cd6-97b2-6f7c73df9941

	measure 'Discount Amount' = SUM ( Sales[Discount EUR] )
		formatString: "€"#,0
		displayFolder: 1 Revenue
		lineageTag: f4feb0bb-9aad-5d96-a1d1-a5bb8fa2f8ca

	measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Revenue] )
		formatString: 0.0%
		displayFolder: 1 Revenue
		lineageTag: 37a2f78e-a9d3-56da-8b5a-45a1c3eb0ae8

	measure Returns = -CALCULATE ( [Net Revenue], Sales[Is Return] = TRUE () )
		formatString: "€"#,0
		displayFolder: 1 Revenue
		lineageTag: 913aed86-19cf-531e-832c-9c11a9d842a8

	measure 'Return Rate' = DIVIDE ( [Returns], CALCULATE ( [Net Revenue], Sales[Is Return] = FALSE () ) )
		formatString: 0.0%
		displayFolder: 1 Revenue
		lineageTag: 2f200f7c-27d8-556e-985b-53a111e86e63

	measure Orders = CALCULATE ( DISTINCTCOUNT ( Sales[Order ID] ), Sales[Is Return] = FALSE () )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: 8f008224-1cde-589c-a754-f74674fe03d5

	measure 'Avg Order Value' = DIVIDE ( CALCULATE ( [Net Revenue], Sales[Is Return] = FALSE () ), [Orders] )
		formatString: "€"#,0
		displayFolder: 1 Revenue
		lineageTag: a95ebc11-044d-558b-8884-3089f8f4c809

	measure Units = SUM ( Sales[Quantity] )
		formatString: #,0
		displayFolder: 1 Revenue
		lineageTag: 4270ab66-240b-51f3-a941-0f4c0cc8771c

	/// Quantity x standard cost.
	measure COGS = SUM ( Sales[Cost EUR] )
		formatString: "€"#,0
		displayFolder: 2 Margin
		lineageTag: dbeb8813-c0b0-580d-bae2-638d6c13010e

	measure 'Gross Margin' = [Net Revenue] - [COGS]
		formatString: "€"#,0
		displayFolder: 2 Margin
		lineageTag: e20760fe-3637-5677-8629-398cc8410074

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Revenue] )
		formatString: 0.0%
		displayFolder: 2 Margin
		lineageTag: fa5382ab-0ef9-59fa-ad2f-1a2829f0c02f

	measure 'Gross Margin % PY' = CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: 0.0%
		displayFolder: 2 Margin
		lineageTag: 4bbf2404-84e0-5052-bc00-52355df295b1

	measure 'Gross Margin % Δ pp' = IF ( NOT ISBLANK ( [Gross Margin % PY] ), ( [Gross Margin %] - [Gross Margin % PY] ) * 100 )
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 2 Margin
		lineageTag: 0c237d0a-00cc-5b0a-882d-629b2d22e28b

	/// Controlling budget, phased to the selected days by working days.
	measure Target =
			-- Monthly budget phased to the selected days by working days, so any date range compares fairly
			SUMX (
			    VALUES ( 'Calendar'[Year Month No] ),
			    VAR _monthTarget =
			        CALCULATE ( SUM ( Target[Target EUR] ), ALLEXCEPT ( 'Calendar', 'Calendar'[Year Month No] ) )
			    VAR _monthWorkdays =
			        CALCULATE ( COUNTROWS ( 'Calendar' ), ALLEXCEPT ( 'Calendar', 'Calendar'[Year Month No] ), 'Calendar'[Is Working Day] = TRUE () )
			    VAR _selectedWorkdays =
			        CALCULATE ( COUNTROWS ( 'Calendar' ), 'Calendar'[Is Working Day] = TRUE () )
			    RETURN
			        DIVIDE ( _monthTarget * _selectedWorkdays, _monthWorkdays )
			)
		formatString: "€"#,0
		displayFolder: 3 Target
		lineageTag: 1a9562cc-5541-5433-b12b-422ed8418657

	/// Target for the days that already have actuals. Use this for achievement in a running period.
	measure 'Target to Date' = CALCULATE ( [Target], KEEPFILTERS ( 'Calendar'[Has Actuals] = TRUE () ) )
		formatString: "€"#,0
		displayFolder: 3 Target
		lineageTag: 2ffbdbfc-bc34-5314-b78d-76e940227910

	measure 'Variance to Target' = [Net Revenue] - [Target to Date]
		formatString: "€"#,0
		displayFolder: 3 Target
		lineageTag: 011d6480-0303-5cee-badf-8361185993f2

	measure 'Target Achievement %' = DIVIDE ( [Net Revenue], [Target to Date] )
		formatString: 0.0%
		displayFolder: 3 Target
		lineageTag: 6cab185c-d219-5dbe-b2b8-89e19c021f84

	measure 'Full Year Forecast' =
			-- Actuals so far + remaining budget, scaled by the achievement rate reached so far
			VAR _year = MAX ( 'Calendar'[Year] )
			VAR _actual = CALCULATE ( [Net Revenue], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = _year )
			VAR _targetToDate = CALCULATE ( [Target to Date], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = _year )
			VAR _targetRest =
			    CALCULATE ( [Target], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = _year, 'Calendar'[Has Actuals] = FALSE () )
			RETURN
			    _actual + _targetRest * DIVIDE ( _actual, _targetToDate, 1 )
		formatString: "€"#,0
		displayFolder: 3 Target
		lineageTag: 6ea07631-d5d2-5877-afe7-4f7fba7b520f

	measure 'Full Year Target' =
			VAR _year = MAX ( 'Calendar'[Year] )
			RETURN CALCULATE ( [Target], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Year] = _year )
		formatString: "€"#,0
		displayFolder: 3 Target
		lineageTag: 87d71304-ea11-5a38-bbfa-4aaebcda7141

	measure 'Forecast vs Full Year Target %' = DIVIDE ( [Full Year Forecast], [Full Year Target] )
		formatString: 0.0%
		displayFolder: 3 Target
		lineageTag: 51d5e653-0b04-5250-b0ab-01aeec62a18f

	/// Same invoices converted at Treasury's planning rate of the year.
	measure 'Net Revenue at Plan FX' = SUM ( Sales[Net EUR at Plan FX] )
		formatString: "€"#,0
		displayFolder: 4 Currency
		lineageTag: 8b77a7a7-ffe2-591b-977d-c3e053739433

	/// Positive = foreign currencies were stronger than planned (tailwind).
	measure 'FX Effect' = [Net Revenue] - [Net Revenue at Plan FX]
		formatString: "€"#,0
		displayFolder: 4 Currency
		lineageTag: a6d2704a-5739-59fb-a7a7-184ec00a7a28

	measure 'FX Effect %' = DIVIDE ( [FX Effect], [Net Revenue at Plan FX] )
		formatString: 0.0%
		displayFolder: 4 Currency
		lineageTag: 61d2de11-d538-5b66-b172-3e840666f4f4

	measure 'Revenue Share Foreign Currency' = DIVIDE ( CALCULATE ( [Net Revenue], Sales[Invoice Currency] <> "EUR" ), [Net Revenue] )
		formatString: 0.0%
		displayFolder: 4 Currency
		lineageTag: 2a8437f2-5522-5ee9-a108-ffacbd0a2b9f

	/// Distinct business customers (not SCD versions) with revenue in the period.
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( Customer[Customer ID] ), Sales )
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: 7b871703-9481-548d-a672-6621535a019c

	measure 'New Customers' =
			VAR _start = MIN ( 'Calendar'[Date] )
			VAR _customers = CALCULATETABLE ( VALUES ( Customer[Customer ID] ), Sales )
			RETURN
			    COUNTROWS (
			        FILTER (
			            _customers,
			            VAR _id = Customer[Customer ID]
			            VAR _firstOrder =
			                CALCULATE ( MIN ( Sales[Order Date] ), REMOVEFILTERS ( 'Calendar' ), REMOVEFILTERS ( Customer ), Customer[Customer ID] = _id )
			            RETURN _firstOrder >= _start
			        )
			    ) + 0
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: 13929327-1613-5080-9b3b-ab81dd956ea7

	/// Customers who ordered in the 12 months before the last 90 days but not since. Ignores the date slicer.
	measure 'Customers at Risk' =
			-- bought in the 12 months before the last 90 days, but not in the last 90 days
			VAR _ref = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS ( 'Calendar' ) )
			VAR _before = CALCULATETABLE ( VALUES ( Customer[Customer ID] ), REMOVEFILTERS ( 'Calendar' ),
			    DATESBETWEEN ( 'Calendar'[Date], _ref - 455, _ref - 90 ), Sales )
			VAR _recent = CALCULATETABLE ( VALUES ( Customer[Customer ID] ), REMOVEFILTERS ( 'Calendar' ),
			    DATESBETWEEN ( 'Calendar'[Date], _ref - 89, _ref ), Sales )
			RETURN COUNTROWS ( EXCEPT ( _before, _recent ) ) + 0
		formatString: #,0
		displayFolder: 5 Customers
		lineageTag: 760781a0-1d0a-537f-87e4-f01d00bc2c50

	/// Revenue of the customers at risk in their last active 12 months.
	measure 'Revenue at Risk' =
			VAR _ref = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS ( 'Calendar' ) )
			VAR _before = CALCULATETABLE ( VALUES ( Customer[Customer ID] ), REMOVEFILTERS ( 'Calendar' ),
			    DATESBETWEEN ( 'Calendar'[Date], _ref - 455, _ref - 90 ), Sales )
			VAR _recent = CALCULATETABLE ( VALUES ( Customer[Customer ID] ), REMOVEFILTERS ( 'Calendar' ),
			    DATESBETWEEN ( 'Calendar'[Date], _ref - 89, _ref ), Sales )
			RETURN
			    CALCULATE ( [Net Revenue], REMOVEFILTERS ( 'Calendar' ), DATESBETWEEN ( 'Calendar'[Date], _ref - 455, _ref - 90 ),
			        TREATAS ( EXCEPT ( _before, _recent ), Customer[Customer ID] ) )
		formatString: "€"#,0
		displayFolder: 5 Customers
		lineageTag: 76ca7a54-28a9-5163-ab87-baa7549744e2

	measure 'Revenue per Customer' = DIVIDE ( [Net Revenue], [Active Customers] )
		formatString: "€"#,0
		displayFolder: 5 Customers
		lineageTag: 85422dc7-b1ac-59e3-a514-c4300d52284c

	measure 'Last Actual Date' = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
		formatString: dd.mm.yyyy
		displayFolder: 9 Report
		lineageTag: 9cd6f5d4-02da-5c10-b451-258784507348

	measure 'Overview Subtitle' =
			"Data through " & FORMAT ( [Last Actual Date], "dd.mm.yyyy" )
			    & "  ·  Target achievement " & FORMAT ( [Target Achievement %], "0.0%" )
			    & "  ·  Forecast " & FORMAT ( [Full Year Forecast] / 1000000, "€0.0" ) & "M of " & FORMAT ( [Full Year Target] / 1000000, "€0.0" ) & "M"
		displayFolder: 9 Report
		lineageTag: a957dc05-2595-592b-928b-4e7820fb0bd1

	/// Used for conditional formatting: green >= 100%, amber >= 90%, red below.
	measure 'Achievement Color' =
			VAR _a = [Target Achievement %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _a ), "#9AA6AF", _a >= 1, "#0E6B63", _a >= 0.9, "#C98A0B", "#C0392B" )
		displayFolder: 9 Report
		lineageTag: e5a93d61-34e4-5b81-9e5e-7f41ae1a53e2

