	partition Sales = m
		mode: import
		source =
				let
				    Source = fnReadGold("fact_sales"),
				    Typed = Table.TransformColumnTypes(Source, {{"order_id", type text}, {"line_no", Int64.Type}, {"order_date", type date}, {"date_key", Int64.Type}, {"customer_sk", Int64.Type}, {"product_sk", Int64.Type}, {"country_code", type text}, {"channel_key", Int64.Type}, {"status", type text}, {"is_return", type logical}, {"quantity", Int64.Type}, {"unit_price_local", type number}, {"discount_pct", type number}, {"currency", type text}, {"fx_rate", type number}, {"planning_rate", type number}, {"gross_local", type number}, {"net_local", type number}, {"gross_eur", type number}, {"discount_eur", type number}, {"net_eur", type number}, {"net_eur_plan_fx", type number}, {"cost_eur", type number}, {"source_file", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
